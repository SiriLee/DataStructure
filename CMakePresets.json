{
  "version": 3,
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "MinGW (g++)",
      "description": "使用 MinGW Makefiles，输出到 build/",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ]
}
